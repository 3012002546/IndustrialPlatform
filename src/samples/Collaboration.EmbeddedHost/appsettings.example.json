{
  "SqlSugar": {
    "DbType": "Sqlite",
    "ConnectionString": "Data Source=embedded-collaboration.local.db",
    "IsAutoCloseConnection": true
  },
  "EmbeddedCollaboration": {
    "AllowedParentOrigins": [
      "https://portal.example.com"
    ],
    "SourceSessionCookieName": "embedded_host_session",
    "DefaultSourceNId": "mes-example",
    "Sources": {
      "mes-example": {
        "Issuer": "https://embedded-host.example.com/identity",
        "Audience": "collaboration.embedded",
        "KeyId": "embedded-source-v1",
        "PrivateKeyPath": "",
        "PublicKeyPath": "",
        "ExternalTenantMappings": {
          "MES-TENANT-EXAMPLE": "T-EXAMPLE"
        },
        "SubjectMappings": {
          "external-subject-example": {
            "ExternalTenantNId": "MES-TENANT-EXAMPLE",
            "DisplayName": "Example operator",
            "SecurityVersion": "1",
            "Status": "Active"
          }
        }
      }
    },
    "SourceSessions": {
      "replace-with-an-upstream-session-cookie": {
        "SourceNId": "mes-example",
        "ExternalTenantNId": "MES-TENANT-EXAMPLE",
        "ExternalSubject": "external-subject-example",
        "DisplayName": "Example operator",
        "SessionNId": "upstream-session-example",
        "SecurityVersion": "1",
        "Status": "Active"
      }
    }
  },
  "AllowedHosts": "*"
}
