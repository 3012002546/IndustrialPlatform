# Industrial Platform 统一前端运行配置示例(安全示例值,不得提交真实凭据)

# 日常 Development 统一入口(UnifiedHost: Identity/SystemData/ReferenceData)
# 独立 Gateway + Api Host 模式请显式覆盖为 http://localhost:5080
VITE_API_BASE_URL=http://localhost:5041

# 认证适配器选择:http(默认,本地真实 Identity;生产构建禁止 mock)
VITE_AUTH_MODE=http

# HTTP 请求超时(毫秒,必须为正整数)
VITE_REQUEST_TIMEOUT_MS=10000

# 部署环境标识(DEV/TEST/UAT/PROD;生产构建必须显式设置)
VITE_DEPLOYMENT_ENVIRONMENT=DEV
