{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "ServiceName": "Identity",
    "MinimumLevel": "Information",
    "Console": { "Enabled": true },
    "File": { "Enabled": false },
    "Seq": { "Enabled": false, "ServerUrl": "http://localhost:5341", "ApiKey": "" }
  },
  "SqlSugar": {
    "ConnectionString": "Data Source=industrial-platform.identity.db",
    "DbType": "Sqlite"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Identity": {
    "Authentication": {
      "DefaultTenantNId": "development"
    },
    "Jwt": {
      "Issuer": "industrial-platform-identity",
      "Audience": "industrial-platform-api",
      "AccessTokenMinutes": 30,
      "KeyId": "identity-default",
      "SigningKey": ""
    }
  }
}
