{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "ServiceName": "ReferenceData",
    "MinimumLevel": "Information",
    "Console": {
      "Enabled": true
    },
    "File": {
      "Enabled": false
    },
    "Seq": {
      "Enabled": false,
      "ServerUrl": "http://localhost:5341",
      "ApiKey": ""
    }
  },
  "SqlSugar": {
    "ConnectionString": "Data Source=industrial-platform.db",
    "DbType": "Sqlite"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "DatabaseTopology": {
    "EnvironmentName": "Development",
    "Mode": "Shared",
    "SharedDatabaseName": "industrial_platform_dev",
    "SharedSqliteFile": "industrial-platform.db",
    "ServiceDatabases": {}
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "industrial",
    "Password": "sample-dev-password",
    "VirtualHost": "/",
    "ExchangeName": "industrial.system"
  },
  "Jwt": {
    "Issuer": "industrial-platform-identity",
    "Audience": "industrial-platform-api",
    "JwksUrl": "http://localhost:5001/.well-known/jwks.json",
    "RequireHttpsMetadata": false
  },
  "ReferenceData": {
    "Identity": {
      "BaseUrl": "http://localhost:5001/"
    },
    "Initialization": {
      "AutoApply": false
    }
  }
}
