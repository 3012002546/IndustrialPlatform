{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "ServiceName": "SystemData",
    "MinimumLevel": "Information",
    "Console": { "Enabled": true },
    "File": { "Enabled": false },
    "Seq": { "Enabled": false, "ServerUrl": "http://localhost:5341", "ApiKey": "" }
  },
  "SqlSugar": {
    "ConnectionString": "Data Source=industrial-platform.systemdata.db",
    "DbType": "Sqlite"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "DatabaseTopology": {
    "EnvironmentName": "Development",
    "Mode": "Shared",
    "SharedDatabaseName": "industrial_platform_dev",
    "SharedSqliteFile": "industrial-platform.db",
    "ServiceDatabases": {}
  },
  "DatabaseOrchestration": {
    "Runner": {
      "Enabled": false,
      "ArtifactRootPath": "",
      "SecretSinkPath": ""
    }
  },
  "Jwt": {
    "JwksUrl": "http://localhost:5041/.well-known/jwks.json",
    "RequireHttpsMetadata": false
  }
}
