# TASK-BASE-002 本地基础设施安全示例配置
# 使用方式: 在 docker/ 目录执行 `cp .env.example .env`,按需修改后启动。
# 注意: 所有值均为开发环境示例,严禁用于生产;真实凭据不得提交。
# .env 已在仓库 .gitignore 中,不会进入版本库。

# --- PostgreSQL ---
POSTGRES_USER=industrial
POSTGRES_PASSWORD=sample-dev-password
POSTGRES_DB=industrial_platform

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=industrial
RABBITMQ_DEFAULT_PASS=sample-dev-password
# 默认虚拟主机 "/"
RABBITMQ_DEFAULT_VHOST=/

# --- Seq ---
# 开发环境仅接受 EULA,不设置初始管理员密码(首次访问由 Seq 引导);
# 生产环境必须配置 SEQ_FIRSTRUN_ADMINPASSWORDHASH 并限定网络。
